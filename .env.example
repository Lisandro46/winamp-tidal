# Only for developer builds. Installers ask each user for their own TIDAL app on first run.
# Client IDs are public (PKCE, no secret). Create apps at:
#   https://developer.tidal.com/dashboard     (redirect URI: https://lisandro46.github.io/winamp-remote-callback/)
MAIN_VITE_TIDAL_CLIENT_ID=
# Optional: catalog mode (search, albums, artists, public playlists) without a user login.
# It ends up inside your build, so don't share installers built with it.
MAIN_VITE_TIDAL_CLIENT_SECRET=
